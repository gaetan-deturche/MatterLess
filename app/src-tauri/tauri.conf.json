{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MatterLess",
  "version": "0.1.0",
  "identifier": "com.gaetandeturche.matterless",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MatterLess",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gaetan-deturche/MatterLess/releases/latest/download/latest.json"
      ],
      "pubkey": "PASTE_THE_PUBLIC_KEY_FROM_TAURI_SIGNER_GENERATE"
    }
  }
}
